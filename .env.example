# Copy to .env locally. Never commit real credentials.
SEC_FILINGS_AGENT_LOG_LEVEL=INFO

# Which LLM provider to use: anthropic (default) or openai. Only the chosen
# provider's key needs to be filled in.
SEC_FILINGS_AGENT_LLM_PROVIDER=anthropic
SEC_FILINGS_AGENT_ANTHROPIC_API_KEY=put-yours-here
# SEC_FILINGS_AGENT_ANTHROPIC_MODEL=claude-sonnet-4-5
SEC_FILINGS_AGENT_OPENAI_API_KEY=put-yours-here
# SEC_FILINGS_AGENT_OPENAI_MODEL=gpt-5.4

# The SEC requires a User-Agent identifying who's accessing.
SEC_FILINGS_AGENT_EDGAR_USER_AGENT=Your Name contact@email.com
