# Copy to .env locally. Never commit real credentials.
AGENTE_FILINGS_SEC_LOG_LEVEL=INFO

# Qual provedor de LLM usar: anthropic (padrão) ou openai. Só a chave do
# provedor escolhido precisa estar preenchida.
AGENTE_FILINGS_SEC_PROVEDOR_LLM=anthropic
AGENTE_FILINGS_SEC_ANTHROPIC_API_KEY=coloque-a-sua-aqui
# AGENTE_FILINGS_SEC_ANTHROPIC_MODELO=claude-sonnet-4-5
AGENTE_FILINGS_SEC_OPENAI_API_KEY=coloque-a-sua-aqui
# AGENTE_FILINGS_SEC_OPENAI_MODELO=gpt-5.4

# A SEC exige um User-Agent que identifique quem está acessando.
AGENTE_FILINGS_SEC_EDGAR_USER_AGENT=Seu Nome contato@email.com
